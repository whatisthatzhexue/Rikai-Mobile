{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rikai.mobile/schemas/agent/analysis.v1.schema.json",
  "title": "Rikai Agent Analysis v1",
  "type": "object",
  "required": ["schema", "source_id", "translation", "segments"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "rikai.agent.analysis.v1"},
    "source_id": {"type": "string", "pattern": "^src-[0-9]+$"},
    "translation": {
      "type": "array",
      "maxItems": 40,
      "items": {"$ref": "#/$defs/translation"}
    },
    "segments": {
      "type": "array",
      "maxItems": 40,
      "items": {"$ref": "#/$defs/segment"}
    },
    "interpretations": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/interpretation"}
    },
    "unresolved": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/unresolved"}
    },
    "citations_used": {
      "type": "array",
      "maxItems": 60,
      "items": {"type": "string", "pattern": "^source-[0-9]+$"}
    },
    "model_supplements": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/supplement"}
    }
  },
  "$defs": {
    "citation_ids": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "pattern": "^source-[0-9]+$"}
    },
    "translation": {
      "type": "object",
      "required": ["quote_id", "text", "label"],
      "additionalProperties": false,
      "properties": {
        "quote_id": {"type": "string", "pattern": "^q[0-9]+$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "label": {"const": "模型译文"},
        "citation_ids": {"$ref": "#/$defs/citation_ids"}
      }
    },
    "segment": {
      "type": "object",
      "required": ["id", "quote_id", "interpretation", "epistemic"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^seg-[0-9]+$"},
        "quote_id": {"type": "string", "pattern": "^q[0-9]+$"},
        "literal": {"type": "string", "maxLength": 4000},
        "interpretation": {"type": "string", "minLength": 1, "maxLength": 8000},
        "word_notes": {
          "type": "array",
          "maxItems": 40,
          "items": {"$ref": "#/$defs/word_note"}
        },
        "grammar_notes": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/grammar_note"}
        },
        "epistemic": {
          "enum": [
            "dictionary_fact",
            "structural_analysis",
            "context_inference",
            "translation"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "word_note": {
      "type": "object",
      "required": ["token_id", "surface", "sense"],
      "additionalProperties": false,
      "properties": {
        "token_id": {"type": "string", "pattern": "^t[0-9]+$"},
        "surface": {"type": "string", "minLength": 1, "maxLength": 200},
        "reading": {"type": "string", "maxLength": 200},
        "sense": {"type": "string", "minLength": 1, "maxLength": 1000},
        "citation_ids": {"$ref": "#/$defs/citation_ids"}
      }
    },
    "grammar_note": {
      "type": "object",
      "required": ["pattern_id", "explanation"],
      "additionalProperties": false,
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^p[0-9]+$"},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "citation_ids": {"$ref": "#/$defs/citation_ids"}
      }
    },
    "interpretation": {
      "type": "object",
      "required": ["id", "label", "meaning", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^i[0-9]+$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 40},
        "meaning": {"type": "string", "minLength": 1, "maxLength": 2000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "citation_ids": {"$ref": "#/$defs/citation_ids"}
      }
    },
    "unresolved": {
      "type": "object",
      "required": ["quote_id", "reason"],
      "additionalProperties": false,
      "properties": {
        "quote_id": {"type": "string", "pattern": "^q[0-9]+$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "supplement": {
      "type": "object",
      "required": ["text", "label"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "label": {"const": "模型补充"}
      }
    }
  }
}
