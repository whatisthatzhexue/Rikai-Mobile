{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rikai.mobile/schemas/agent/coverage.v1.schema.json",
  "title": "Rikai Agent Coverage Review v1",
  "description": "One bounded review after initial evidence lookup. The orchestrator validates traceability and decides whether a single supplementary lookup pass is allowed.",
  "type": "object",
  "required": ["schema", "source_id", "verdict", "missing", "duplicate_groups"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "rikai.agent.coverage.v1"},
    "source_id": {"type": "string", "pattern": "^src-[0-9]+$"},
    "verdict": {"enum": ["sufficient", "missing"]},
    "missing": {
      "type": "array",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/missing"}
    },
    "duplicate_groups": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/duplicate_group"}
    },
    "notes": {"type": "string", "maxLength": 1000}
  },
  "$defs": {
    "missing": {
      "type": "object",
      "required": ["kind", "query", "source_refs", "reason"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["word", "grammar", "sense", "usage", "reading", "example", "context"]
        },
        "query": {"type": "string", "minLength": 1, "maxLength": 100},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^(t[0-9]+|p[0-9]+|src-[0-9]+)$"
          }
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "priority": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "duplicate_group": {
      "type": "object",
      "required": ["dictionary_id", "keep_entry_key", "remove_entry_keys", "reason"],
      "additionalProperties": false,
      "properties": {
        "dictionary_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "keep_entry_key": {"type": "string", "minLength": 1, "maxLength": 400},
        "remove_entry_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 400}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
