{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rikai.mobile/schemas/agent/annotation-rules.v1.schema.json",
  "title": "Rikai Annotation Rules v1",
  "type": "object",
  "required": ["schema", "id", "name", "version", "targets", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "rikai.annotation.rules.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "version": {"type": "integer", "minimum": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["reader", "photo", "corpus"]}
    },
    "rules": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["ruby", "pitch", "bold", "underline"]
        },
        "when": {"$ref": "#/$defs/when"}
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pos1": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 32}
        },
        "pos2": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 32}
        },
        "pos3": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 32}
        },
        "pos4": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 32}
        },
        "lemma": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 100}
        },
        "surface": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 100}
        },
        "hasReading": {"type": "boolean"},
        "hasPitch": {"type": "boolean"},
        "target": {"enum": ["reader", "photo", "corpus"]}
      }
    }
  }
}
