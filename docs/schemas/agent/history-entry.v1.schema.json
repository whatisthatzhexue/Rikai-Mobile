{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rikai.mobile/schemas/agent/history-entry.v1.schema.json",
  "title": "Rikai Agent History Entry v1",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "session_id",
    "title",
    "status",
    "mode",
    "started_at",
    "image_count",
    "has_result"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "rikai.agent.history-entry.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": "string", "maxLength": 200},
    "status": {"enum": ["done", "error", "cancelled", "interrupted"]},
    "mode": {"enum": ["strict", "loose"]},
    "provider_label": {"type": "string", "maxLength": 100},
    "small_model": {"type": "string", "maxLength": 200},
    "complex_model": {"type": "string", "maxLength": 200},
    "started_at": {"type": "integer", "minimum": 0},
    "finished_at": {"type": "integer", "minimum": 0},
    "image_count": {"type": "integer", "minimum": 0, "maximum": 6},
    "has_result": {"type": "boolean"},
    "error_code": {"type": "string", "maxLength": 64}
  }
}
