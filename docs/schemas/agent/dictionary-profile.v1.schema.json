{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rikai.mobile/schemas/agent/dictionary-profile.v1.schema.json",
  "title": "Rikai Dictionary Profile v1",
  "type": "object",
  "required": [
    "schema",
    "dictionary_id",
    "title",
    "kind",
    "entry_structure",
    "search_behavior",
    "confidence",
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "rikai.dictionary.profile.v1"},
    "dictionary_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "kind": {"type": "string", "minLength": 1, "maxLength": 80},
    "languages": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 2, "maxLength": 16}
    },
    "entry_structure": {
      "type": "object",
      "required": ["headword_fields", "definition_fields"],
      "additionalProperties": false,
      "properties": {
        "headword_fields": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "maxLength": 80}
        },
        "definition_fields": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 80}
        },
        "has_ruby": {"type": "boolean"},
        "has_kanji_info": {"type": "boolean"},
        "has_examples": {"type": "boolean"},
        "has_audio": {"type": "boolean"},
        "has_images": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "search_behavior": {
      "type": "object",
      "required": ["exact_forms", "prefix_suggestions"],
      "additionalProperties": false,
      "properties": {
        "exact_forms": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 80}
        },
        "prefix_suggestions": {"type": "boolean"},
        "notes": {"type": "string", "maxLength": 1000}
      }
    },
    "strengths": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "maxLength": 200}
    },
    "caveats": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "maxLength": 200}
    },
    "recommended_query_forms": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "maxLength": 80}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "schema_version": {"type": "integer", "minimum": 1}
  }
}
