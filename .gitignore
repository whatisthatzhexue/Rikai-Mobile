# User-supplied / development data. Never commit dictionaries or UniDic.
/unidic/
/mdicts/

# Upstream reference clones (their own .git). Adapted code lives in
# packages/ and third_party/.
/overlay-translator/
/PaddleOCR4Android/

# User-supplied fonts. HarmonyOS Sans is not redistributed with the app; see
# assets/fonts/README.md for the download instructions.
/assets/fonts/*.ttf
/assets/fonts/*.otf
/assets/fonts/*.ttc

# Model binaries are downloaded at runtime (see assets/models/manifest.json).
**/*.onnx
**/*.nb
**/*.pdmodel
**/*.pdiparams
**/*.tflite
**/*.gguf
**/*.mlmodel
**/*.bin.part

# Vendored package build outputs / WASM artifacts.
/packages/mecab_for_dart/emcc_out/
**/build/
**/.dart_tool/
**/.gradle/

# Signing and local machine configuration.
local.properties
android/local.properties
key.properties
*.jks
*.keystore
*.p12

