# ---------------------------------------------------------------------------
# LexiCandy repository
# ---------------------------------------------------------------------------

# Local development/user data. Never commit dictionaries, UniDic or test images.
/data/
/mdicts/
/test_images/
/unidic/

# Upstream reference clones (their own .git). Buildable vendored code lives in
# app/packages/ or worker/src/_vendor/; third_party/ only records provenance.
/third_party/upstream/
/overlay-translator/
/PaddleOCR4Android/

# Optional user-supplied fonts at the top level. Bundled Kiyosuna Sans lives
# under app/assets/fonts/KiyosunaSans/ and is tracked with its OFL README.
/app/assets/fonts/*.ttf
/app/assets/fonts/*.otf
/app/assets/fonts/*.ttc

# Model binaries are downloaded at runtime (see app/assets/models/manifest.json).
**/*.onnx
**/*.nb
**/*.pdmodel
**/*.pdiparams
**/*.tflite
**/*.gguf
**/*.mlmodel
**/*.part

# Vendored package build outputs / WASM artifacts.
/app/packages/mecab_for_dart/emcc_out/
**/build/
**/.dart_tool/
**/.gradle/
**/.kotlin/
**/.cxx/
**/.externalNativeBuild/

# Signing and local machine configuration.
local.properties
app/android/local.properties
key.properties
*.jks
*.keystore
*.p12

# Claude Code per-machine settings (shared .claude/*.json may be committed).
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Flutter / Dart defaults
# ---------------------------------------------------------------------------
*.class
*.log
*.pyc
*.swp
*.orig
*.rej
*.tmp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

*.iml
*.ipr
*.iws
.idea/

#.vscode/

**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/

app.*.symbols
app.*.map.json

# Android packages produced outside build/ (defensive; normal builds stay
# under build/app/outputs/).
*.apk
*.aab

/app/android/app/debug
/app/android/app/profile
/app/android/app/release
# Gradle wrapper copies kept out of the index; the tracked wrapper itself is
# re-included by app/android/.gitignore so a fresh clone can still run ./gradlew.
/app/android/gradlew
/app/android/gradlew.bat
/app/android/**/gradle-wrapper.jar
