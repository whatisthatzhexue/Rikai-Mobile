# ---------------------------------------------------------------------------
# Rikai-Mobile
# ---------------------------------------------------------------------------

# User-supplied / development data. Never commit dictionaries or UniDic.
/unidic/
/mdicts/
/test_images/

# Upstream reference clones (their own .git). Adapted code lives in
# packages/ and third_party/.
/overlay-translator/
/PaddleOCR4Android/

# User-supplied fonts. HarmonyOS Sans is not redistributed with the app; see
# assets/fonts/README.md for the download instructions.
/assets/fonts/*.ttf
/assets/fonts/*.otf
/assets/fonts/*.ttc

# Model binaries are downloaded at runtime (see assets/models/manifest.json).
**/*.onnx
**/*.nb
**/*.pdmodel
**/*.pdiparams
**/*.tflite
**/*.gguf
**/*.mlmodel
**/*.part

# Vendored package build outputs / WASM artifacts.
/packages/mecab_for_dart/emcc_out/
**/build/
**/.dart_tool/
**/.gradle/
**/.kotlin/
**/.cxx/
**/.externalNativeBuild/

# Signing and local machine configuration.
local.properties
android/local.properties
key.properties
*.jks
*.keystore
*.p12

# Claude Code per-machine settings (shared .claude/*.json may be committed).
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Flutter / Dart defaults
# ---------------------------------------------------------------------------
*.class
*.log
*.pyc
*.swp
*.orig
*.rej
*.tmp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

*.iml
*.ipr
*.iws
.idea/

#.vscode/

**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/

app.*.symbols
app.*.map.json

# Android packages produced outside build/ (defensive; normal builds stay
# under build/app/outputs/).
*.apk
*.aab

/android/app/debug
/android/app/profile
/android/app/release
